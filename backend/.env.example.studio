SERVER_HOST=0.0.0.0
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
JWT_SECRET=change-me-in-production
DB_HOST=localhost
DB_PORT=5432
DB_USER=masterfabric
DB_PASSWORD=masterfabric
DB_NAME=masterfabric
DB_SSLMODE=disable
KAFKA_ENABLED=false
APP_ENV=development

# =============================================================================
# Hybrid LLM — pick ONE mode (see deployments/LLM_HYBRID.md)
# =============================================================================

# --- Mode A: Fast dev (default) — in-process mock, no GPU, no network ---
LLM_ENABLED=true
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_ALLOW_MOCK_IN_PRODUCTION=false
SERVER_WRITE_TIMEOUT_SECONDS=90

# --- Mode B: Hugging Face external (uncomment, comment Mode A mock lines) ---
# LLM_PROVIDER=gemma
# LLM_BASE_URL=https://router.huggingface.co/v1
# LLM_MODEL=google/gemma-2-2b-it:featherless-ai
# LLM_API_KEY=hf_...
# LLM_TIMEOUT_SECONDS=120
# SERVER_WRITE_TIMEOUT_SECONDS=130

# --- Mode C/D: Compose stack — API via nginx :8080, MLC on :8081 ---
# Use make compose-up-full (mock) or make compose-up-mlc-gpu (real GPU MLC).
# Native API on host pointing at compose MLC mock:
# LLM_PROVIDER=gemma
# LLM_BASE_URL=http://127.0.0.1:8081/v1
# LLM_MODEL=mock-mlc-model
# LLM_API_KEY=local-dev
# LLM_TIMEOUT_SECONDS=120
# SERVER_WRITE_TIMEOUT_SECONDS=130

# --- Mode D: Local Docker MLC GPU (standalone or compose-up-mlc-gpu) ---
# LLM_PROVIDER=gemma
# LLM_BASE_URL=http://127.0.0.1:8081/v1
# LLM_MODEL=HF://mlc-ai/gemma-2b-it-q4f16_1-MLC
# LLM_API_KEY=local-dev
# LLM_TIMEOUT_SECONDS=120
# SERVER_WRITE_TIMEOUT_SECONDS=130
# MLC_MODEL=HF://mlc-ai/gemma-2b-it-q4f16_1-MLC
# MLC_MODE=local

# --- Mode E: Render production — set in Render dashboard, not local .env ---
# LLM_PROVIDER=gemma
# LLM_BASE_URL=https://mlc.your-domain.com/v1
# LLM_ALLOW_MOCK_IN_PRODUCTION=false
# See deployments/render-external-llm.md

SERVER_READ_TIMEOUT_SECONDS=15

# Phase 5 Compose stack URLs (make compose-up-full)
# API via nginx LB: http://localhost:8080
# MLC mock direct: http://localhost:8081
# Grafana: http://localhost:3001 (admin/admin)
# Prometheus: http://localhost:9090

LOG_LEVEL=info
LOG_FORMAT=json
REDIS_HOST=localhost
REDIS_PORT=6379

# Copy to .env and adjust on your GPU training host.

# Path to export-peft-dataset output (train.jsonl, val.jsonl, manifest.json)
DATASET_DIR=../../peft-export

# Training output (LoRA adapter + run_meta.json)
OUTPUT_DIR=./output

# Base model — must match your inference stack (Gemma 2 2B instruct)
MODEL_NAME=unsloth/gemma-2-2b-it-bnb-4bit

# Hyperparameters (optional overrides for train_lora.py CLI)
EPOCHS=3
BATCH_SIZE=2
GRAD_ACCUM=4
LEARNING_RATE=2e-4
LORA_R=16
LORA_ALPHA=16
MAX_SEQ_LENGTH=8192

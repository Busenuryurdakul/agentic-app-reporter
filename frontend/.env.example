# Backend API host root (no path suffix).
# Local: nginx or native API on port 8080.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Notes:
# - Use the backend host root only — do NOT append /api/v1.
# - On Vercel (Production), set this to your Render service URL, e.g.:
#   NEXT_PUBLIC_API_BASE_URL=https://agentic-app-reporter-api.onrender.com
# - Redeploy Vercel after changing this variable (NEXT_PUBLIC_* is inlined at build time).
